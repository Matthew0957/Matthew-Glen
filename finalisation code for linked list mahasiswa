#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

struct Mahasiswa {
    string nim;
    string nama;
    int kehadiran;
};

struct Node {
    Mahasiswa data;
    Node* next;
};

class LinkedList {
private:
    Node* head;

public:
    LinkedList() {
        head = nullptr;
    }

    void insertLast(Mahasiswa mhs) {
        Node* baru = new Node;
        baru->data = mhs;
        baru->next = nullptr;

        if (head == nullptr) {
            head = baru;
        } else {
            Node* bantu = head;

            while (bantu->next != nullptr) {
                bantu = bantu->next;
            }

            bantu->next = baru;
        }

        cout << "[+] " << mhs.nama
             << " (NIM: " << mhs.nim
             << ") ditambahkan di BELAKANG (Last)." << endl;
    }

    void inserthead(Mahasiswa mhs) {
        Node* baru = new Node;
        baru->data = mhs;
        baru->next = head;

        head = baru;

        cout << "[+] " << mhs.nama
             << " (NIM: " << mhs.nim
             << ") ditambahkan di DEPAN (First)." << endl;
    }

    void deletehead() {
        if (head == nullptr) {
            cout << "[-] Linked List kosong!" << endl;
            return;
        }

        Node* hapus = head;

        cout << "[-] " << hapus->data.nama
             << " berhasil dihapus dari DEPAN." << endl;

        head = head->next;
        delete hapus;
    }

    void deleteLast() {
        if (head == nullptr) {
            cout << "[-] Linked List kosong!" << endl;
            return;
        }

        if (head->next == nullptr) {
            cout << "[-] " << head->data.nama
                 << " berhasil dihapus dari BELAKANG." << endl;

            delete head;
            head = nullptr;
            return;
        }

        Node* bantu = head;

        while (bantu->next->next != nullptr) {
            bantu = bantu->next;
        }

        Node* hapus = bantu->next;

        cout << "[-] " << hapus->data.nama
             << " berhasil dihapus dari BELAKANG." << endl;

        bantu->next = nullptr;
        delete hapus;
    }

    void display() {
        if (head == nullptr) {
            cout << "\nLinked List kosong!\n";
            return;
        }

        cout << "\n";
        cout << "=============================================================="
             << endl;
        cout << "           DAFTAR KEHADIRAN MAHASISWA (LINKED LIST)"
             << endl;
        cout << "=============================================================="
             << endl;

        cout << left
             << setw(5) << "No"
             << setw(17) << "NIM"
             << setw(32) << "Nama Mahasiswa"
             << setw(12) << "Kehadiran"
             << endl;

        cout << "--------------------------------------------------------------"
             << endl;

        Node* bantu = head;
        int no = 1;

        while (bantu != nullptr) {
            cout << left
                 << setw(5) << no
                 << setw(17) << bantu->data.nim
                 << setw(32) << bantu->data.nama
                 << setw(12)
                 << (to_string(bantu->data.kehadiran) + "%")
                 << endl;

            bantu = bantu->next;
            no++;
        }

        cout << "=============================================================="
             << endl;
    }

    void search(string nim) {
        Node* bantu = head;

        while (bantu != nullptr) {
            if (bantu->data.nim == nim) {
                cout << "\nData ditemukan!" << endl;
                cout << "NIM       : " << bantu->data.nim << endl;
                cout << "Nama      : " << bantu->data.nama << endl;
                cout << "Kehadiran : " << bantu->data.kehadiran << "%" << endl;
                return;
            }

            bantu = bantu->next;
        }

        cout << "\nData dengan NIM " << nim
             << " tidak ditemukan." << endl;
    }

    int count() {
        int jumlah = 0;
        Node* bantu = head;

        while (bantu != nullptr) {
            jumlah++;
            bantu = bantu->next;
        }

        return jumlah;
    }

    ~LinkedList() {
        Node* bantu;

        while (head != nullptr) {
            bantu = head;
            head = head->next;
            delete bantu;
        }
    }
};

