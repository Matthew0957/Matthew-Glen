#include <iostream>
using namespace std;

struct ElmList {
    int info;
    ElmList* next;
};

struct List {
    ElmList* first;
};

void createList(List &L) {
    L.first = nullptr;
}

ElmList* createNewElement(int value) {
    ElmList* P = new ElmList;
    P->info = value;
    P->next = nullptr;
    return P;
}


void insertLast(List &L, ElmList* P) {
    if (L.first == nullptr) {
        L.first = P;
    } else {
        ElmList* Q = L.first;
        while (Q->next != nullptr) {
            Q = Q->next;
        }
        Q->next = P;
    }
}

void printList(List L) {
    ElmList* P = L.first;
    while (P != nullptr) {
        cout << P->info << " -> ";
        P = P->next;
    }
    cout << "nullptr" << endl;
}

int main() {
    List L;
    createList(L);


    insertLast(L, createNewElement(10));
    insertLast(L, createNewElement(20));
    insertLast(L, createNewElement(30));

    cout << "Hasil Insert Last (10, 20, 30):" << endl;
    printList(L);

    return 0;
}
